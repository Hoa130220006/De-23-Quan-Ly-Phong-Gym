# ==========================================================
# BIẾN MÔI TRƯỜNG MẪU CHO TITAN FITNESS GYM MANAGEMENT
# SAO CHÉP TỆP NÀY THÀNH .env ĐỂ SỬ DỤNG TRONG DOCKER COMPOSE
# ==========================================================

# 1. Cấu hình Cơ sở dữ liệu MySQL
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=gym_management
MYSQL_USER=gym_user
MYSQL_PASSWORD=your_gym_user_password_here
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gym_management
DB_USER=gym_user
DB_PASS=your_gym_user_password_here

# 2. Cấu hình Cổng Dịch Vụ Nginx & Giám sát
APP_PORT_HTTP=80
APP_PORT_HTTPS=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# 3. Tài khoản quản trị Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
